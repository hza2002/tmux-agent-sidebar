{
  "name": "hiroppy",
  "owner": {
    "name": "Yuta Hiroto"
  },
  "plugins": [
    {
      "name": "tmux-agent-sidebar",
      "source": {
        "source": "command",
        "command": "d=\"${TMUX_AGENT_SIDEBAR_SOURCE:-$HOME/.config/tmux/plugins/tmux-agent-sidebar}\"; [ -f \"$d/hooks/hooks.json\" ] || d=\"$HOME/.tmux/plugins/tmux-agent-sidebar\"; cd \"$d\" && pwd -P",
        "mode": "link"
      },
      "description": "Monitor Claude Code agents across tmux panes in a real-time sidebar TUI"
    }
  ]
}
